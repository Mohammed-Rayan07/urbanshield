# Copy to .env (never commit .env).

# LLM: live | replay | mock
#   mock   – deterministic scripted agents, no key needed (default; CI uses this)
#   replay – serve recorded responses from backend/fixtures/traces (demo video, offline venue)
#   live   – any OpenAI-compatible Chat Completions endpoint with function calling
#   Gemini free tier: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   and set both model names to current Gemini model IDs from https://ai.google.dev/gemini-api/docs/models
LLM_MODE=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=

# Audit log signing key (64 hex chars, Ed25519 seed). Generate once, keep it secret:
#   python -c "from nacl.signing import SigningKey; print(SigningKey.generate().encode().hex())"
# Empty = an ephemeral key per process: /api/health says audit_key "ephemeral" and entries
# written before a restart no longer verify.
AUDIT_SIGNING_KEY=

# Demo budget for /plans and incidents, and how long a run waits for an approver (seconds).
BUDGET_INR=150000
DOWNTIME_H=24
APPROVAL_TIMEOUT_S=600

# Judge Mode "tamper with the log" button (POST /api/audit/tamper). Off unless set to 1.
ALLOW_DEMO_TAMPER=0

CITY_SEED=7
N_SCENARIOS=2000
DB_PATH=
CORS_ORIGINS=http://localhost:5173
